# ---------- AI (Vercel AI Gateway) ----------
# Create at: Vercel dashboard -> AI Gateway -> API Keys -> Create key
AI_GATEWAY_API_KEY=
# Optional model overrides (defaults shown)
AI_MODEL_CHAT=google/gemini-2.5-flash-lite
AI_MODEL_VISION=google/gemini-2.5-flash-lite
AI_MODEL_ANALYSIS=google/gemini-3-flash
# Optional: comma-separated list of allowed site origins (blocks other sites from using your key)
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000

# ---------- Excel sync (Vercel Blob) - see docs/SETUP.md ----------
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Blob store to the project.
# For local testing against the real store, copy it here (or run `vercel env pull .env.local`).
# Without it, `node dev-server.mjs` writes the Excel file to .data/agrosphere-ai-data.xlsx instead.
BLOB_READ_WRITE_TOKEN=
SYNC_SECRET=                      # any long random string, e.g. openssl rand -hex 32
SHEET_ADMIN_KEY=                  # password for downloading the Excel file: /api/sheet?download&key=...
EXCEL_BLOB_PATH=agrosphere-ai-data.xlsx
